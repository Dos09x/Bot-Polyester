# ─── Polyester Testnet — API Credentials ──────────────────────────────────────
# Salin file ini menjadi .env lalu isi nilainya
# cp .env.example .env

POLYESTER_API_KEY_ID=
POLYESTER_API_PRIVATE_KEY=
POLYESTER_ACCOUNT_ID=

# ─── Trading Switch ────────────────────────────────────────────────────────────
# Set true untuk mulai kirim order ke TESTNET
TRADING_ENABLED=false

# ─── Order Size ────────────────────────────────────────────────────────────────
ORDER_SIZE_USDT=100

# ─── Timing ───────────────────────────────────────────────────────────────────
# Jarak antar siklus (detik)
POLL_SECONDS=5

# Setiap berapa siklus ringkasan PnL dicetak di log
PNL_SUMMARY_INTERVAL=12

# Timeout API call (detik)
API_TIMEOUT_SEC=30

# ─── State File ───────────────────────────────────────────────────────────────
BOT_STATE_FILE=bot_state.json